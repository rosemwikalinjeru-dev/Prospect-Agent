# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Maps data provider ---
# Which scraper implementation to use: apify | serpapi | places_api
# Only the credential for the selected provider needs to be filled in below.
SCRAPER_PROVIDER=apify

# Apify (https://apify.com) — runs the "Google Maps Scraper" actor. Preferred provider.
APIFY_API_TOKEN=
APIFY_GOOGLE_MAPS_ACTOR_ID=compass/crawler-google-places

# SerpApi (https://serpapi.com) — alternative provider.
SERPAPI_API_KEY=

# Google Maps (Places API) — only needed if SCRAPER_PROVIDER=places_api
GOOGLE_MAPS_API_KEY=

# --- Airtable ---
# Personal Access Token from https://airtable.com/create/tokens — scope it to just this
# base if possible (data.records:read, data.records:write, schema.bases:read).
AIRTABLE_API_KEY=
# The base ID (starts with "app...") — visible in the base's API docs / URL.
AIRTABLE_BASE_ID=
AIRTABLE_LEADS_TABLE_NAME=Leads
# Table used by --rotate-cities (see README) — same base as above, separate table.
AIRTABLE_CITIES_TABLE_NAME=Cities

# --- Pipeline behavior ---
MIN_LEAD_SCORE=7
MAX_RESULTS_PER_SEARCH=60
REQUEST_DELAY_SECONDS=0.5
CITIES_PER_RUN=5
LOG_LEVEL=INFO
